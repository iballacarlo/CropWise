# App settings
NODE_ENV=development
PORT=3000
# Exact browser origins separated by commas; blank disables browser CORS access.
CORS_ORIGINS=

# MySQL connection. Set DB_USERNAME and DB_PASSWORD to your local values.
# DB_PASSWORD may be empty only when that is the password configured in MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=cropwise_db

# Generate a private secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Optional one-time admin account setup. Leave blank unless you are seeding it.
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
